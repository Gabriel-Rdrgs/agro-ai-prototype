# ============================================
# BACKEND - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env real (apenas este .env.example)

# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/agro_ai
DIRECT_URL=postgresql://user:password@localhost:5432/agro_ai

# ============================================
# AUTENTICAÇÃO
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# SERVIÇOS EXTERNOS
# ============================================
PYTHON_API_URL=http://localhost:8000
AWESOME_API_URL=https://economia.awesomeapi.com.br

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development
RAILWAY_STATIC_URL=

# ============================================
# OBSERVABILIDADE
# ============================================
SENTRY_DSN=

# ============================================
# JOBS AGENDADOS
# ============================================
ENABLE_WEATHER_SYNC=true
WEATHER_SYNC_SCHEDULE=0 2 * * *
WEATHER_SYNC_SCRIPT_PATH=ai-service/scripts/sync_weather_data.py