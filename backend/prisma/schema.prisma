generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
  // ✅ PERF-004: Connection pool configurado
  relationMode = "prisma"
}

model Opportunity {
  id           Int                      @id @default(autoincrement())
  product      String
  category     String
  city         String
  state        String
  lat          Float
  lng          Float
  buyPrice     Decimal                  @db.Decimal(10, 2)
  sellPrice    Decimal                  @db.Decimal(10, 2)
  sellLocation String
  destLat      Float?
  destLng      Float?
  volume       String
  riskLevel    Int
  climate      String
  description  String?
  season       String?
  createdAt    DateTime                 @default(now())
  geom         Unsupported("geometry")?
  bestRoute    Boolean                  @default(false)
  freight      Decimal?                 @db.Decimal(10, 2)
  roi          Float?                   @default(0)
  history      PriceHistory[]
  favorites    Favorite[] // ✅ NOVO: Relação com favoritos
  portfolioOperations PortfolioOperation[] // ✅ NOVO: Relação com operações do portfolio

  @@index([geom], map: "opportunity_geom_idx", type: Gist)
  @@index([product])
  @@index([product, state])
  @@index([state])
  @@index([roi]) // ✅ OTIMIZAÇÃO: Índice para ordenação rápida por ROI
  @@index([createdAt]) // ✅ OTIMIZAÇÃO: Índice para ordenação por data
}

model PriceHistory {
  id            Int         @id @default(autoincrement())
  opportunityId Int
  price         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          String         @default("analyst")
  createdAt     DateTime       @default(now())
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  // alerts removido - Alert.userId é String (UUID), não pode ter relação com User.id (Int)
  portfolioOperations PortfolioOperation[] // ✅ NOVO: Relação com operações do portfolio
  
  // ✅ FASE B - B2: Campos para sistema de alertas
  alertsEnabled        Boolean  @default(false)
  telegramChatId      String?  // ID do chat do Telegram
  phone                String?  // Telefone para WhatsApp (formato: +5511999999999)
  preferredAlertChannel String  @default("email") // "email", "telegram", "whatsapp"
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  userId    Int?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CeasaPrice {
  id             Int      @id @default(autoincrement())
  ceasa_region   String
  ceasa_name     String
  product_name   String
  unit_type      String?
  price_min      Decimal  @db.Decimal(10, 2)
  price_max      Decimal  @db.Decimal(10, 2)
  price_avg      Decimal  @db.Decimal(10, 2)
  price_date     DateTime
  sync_timestamp DateTime @default(now())
  is_projection  Boolean  @default(false)
  data_type      String?

  @@unique([ceasa_region, product_name, price_date])
  @@index([product_name])
  @@index([ceasa_region])
  @@index([price_date])
  @@index([is_projection])
  @@index([product_name, price_date], map: "CeasaPrice_product_date_idx")
  @@index([ceasa_region], map: "CeasaPrice_region_idx")
}

model CeasaSyncLog {
  id             Int      @id @default(autoincrement())
  source         String
  status         String
  records_synced Int
  error_message  String?
  sync_timestamp DateTime @default(now())

  @@index([source])
  @@index([sync_timestamp])
}

model FuelPrice {
  id              Int      @id @default(autoincrement())
  state_code      String
  price_per_liter Float
  data_coleta     DateTime
  fonte           String?
  created_at      DateTime @default(now())

  @@map("fuel_prices")
}

model Document {
  id        String                 @id @default(uuid())
  content   String
  metadata  Json?
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())

  @@map("documents")
}

model IBGEProduction {
  id             Int       @id @default(autoincrement())
  product_name   String
  state_code     String
  variable       String
  value          Decimal   @db.Decimal(15, 2)
  year           Int
  source         String?   @default("IBGE")
  data_date      DateTime  @db.Timestamp(6)
  sync_timestamp DateTime? @default(now()) @db.Timestamp(6)

  @@unique([product_name, state_code, variable, year])
  @@index([product_name], map: "idx_ibge_product")
  @@index([state_code], map: "idx_ibge_state")
  @@index([year], map: "idx_ibge_year")
}

model market_prices {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime  @db.Date
  product    String    @db.VarChar(50)
  region     String?   @default("BR") @db.VarChar(50)
  price      Decimal   @db.Decimal(10, 2)
  unit       String    @db.VarChar(20)
  source     String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([date, product, region], map: "unique_price_entry")
  @@index([date], map: "idx_market_prices_date")
  @@index([product], map: "idx_market_prices_product")
}

// ✅ FASE 0 - Semana 3: Dados Climáticos Históricos
model WeatherData {
  id              Int      @id @default(autoincrement())
  lat             Float
  lng             Float
  date            DateTime @db.Date
  temperature_max Float?
  temperature_min Float?
  precipitation   Float? // mm
  radiation_mj    Float? // MJ/m²
  humidity_avg    Float? // %
  et0             Float? // Evapotranspiração de referência (mm)
  source          String   @default("open-meteo")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([lat, lng, date, source])
  @@index([lat, lng])
  @@index([date])
  @@index([lat, lng, date])
  @@map("weather_data")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

// ✅ NOVO: Favoritos - Permite usuários salvarem oportunidades para acompanhar
// Nota: userId é String (UUID do Supabase Auth), não há relação com User pois User.id é Int
model Favorite {
  id            Int      @id @default(autoincrement())
  userId        String // UUID do Supabase Auth (não Int, pois vem do Supabase)
  opportunityId Int
  notes         String? // Notas do usuário sobre esta oportunidade
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Índices para performance
  @@unique([userId, opportunityId]) // Um usuário não pode favoritar a mesma oportunidade duas vezes
  @@index([userId])
  @@index([opportunityId])
  @@index([createdAt])
}

// ✅ FASE B - B2: Sistema de Alertas - Permite usuários configurarem alertas personalizados
// Nota: userId é String (UUID do Supabase Auth), não há relação com User pois User.id é Int
model Alert {
  id            Int      @id @default(autoincrement())
  userId        String   // UUID do Supabase Auth (não Int, pois vem do Supabase)
  
  // Campos específicos para regras de alerta
  product       String?  // Produto específico (ex: "Tomate", "Soja", "Milho") - null = todos
  minRoi        Float?   // ROI mínimo para disparar alerta
  minProfit     Float?   // Lucro mínimo em R$ para disparar alerta
  regions       String?  @db.Text // JSON array de estados (ex: ["SP", "MG", "GO"]) - null = todos
  
  // Campos genéricos
  type          String   @default("opportunity") // "opportunity", "price_change", "extreme_weather"
  config        String?  @db.Text // JSON string com configuração adicional específica do alerta
  channels      String   @default("[\"email\"]") // JSON array: ["email", "whatsapp", "telegram"]
  
  isActive      Boolean  @default(true)
  lastTriggered DateTime?
  triggerCount  Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@index([product])
  @@index([createdAt])
  @@index([userId, isActive]) // Índice composto para queries frequentes
}

// ✅ NOVO: Portfolio Tracking - Rastreamento de operações de compra/venda
model PortfolioOperation {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  opportunityId Int?     // Referência à oportunidade original (opcional)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  
  type          String   // "buy", "sell"
  product       String
  origin        String   // Cidade, Estado
  destination   String   // Cidade, Estado
  
  quantity      Float    // kg
  price         Float    // R$/kg
  totalValue    Float    // quantity * price
  
  projectedROI  Float?   // ROI projetado no momento da compra
  actualROI     Float?   // ROI real (calculado após venda)
  
  status        String   // "planned", "in_progress", "completed", "cancelled"
  
  notes         String?  // Notas do usuário
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([opportunityId])
}
