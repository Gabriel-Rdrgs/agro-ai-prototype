// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- MODELOS DE NEGÓCIO ---

model Opportunity {
  id           Int      @id @default(autoincrement())
  product      String   // Ex: Tomate
  category     String   // Ex: Hortifruti
  
  // Localização Origem
  city         String
  state        String
  lat          Float
  lng          Float

  // Dados Financeiros
  buyPrice     Float    // Preço Compra
  sellPrice    Float    // Preço Venda
  
  // Dados Destino
  sellLocation String   // Ex: CEAGESP - SP
  destLat      Float?
  destLng      Float?

  // Detalhes
  volume       String   // Ex: "500 cx"
  riskLevel    Int      // 1=Baixo, 2=Médio, 3=Alto
  climate      String   // Ex: "Chuva: 50mm"
  description  String?
  season       String?  // Ex: "Safra de Inverno"

  createdAt    DateTime @default(now())

  history      PriceHistory[]

  // Guarda o ponto exato (Latitude/Longitude) num formato que o banco consegue medir distância
  geom    Unsupported("geometry(Point, 4326)")? 

  // Cria um índice especial para buscas rápidas (GIST)
  @@index([geom], name: "opportunity_geom_idx", type: Gist)
}

model PriceHistory {
  id            Int         @id @default(autoincrement())
  
  // Relação com a Oportunidade
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  opportunityId Int
  
  price         Float       // O preço registrado naquele dia
  createdAt     DateTime    @default(now()) // Data do registro
}

// --- MODELOS DE AUTENTICAÇÃO ---

// backend/prisma/schema.prisma

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          String         @default("analyst")
  createdAt     DateTime       @default(now())
  
  refreshTokens RefreshToken[] 
  
  // ADICIONE ESTA LINHA ABAIXO 👇
  auditLogs     AuditLog[]    
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // Ex: "LOGIN", "CREATE_OPPORTUNITY", "DELETE_USER"
  details   String?  // Ex: "Usuário logou com IP X" ou JSON com dados antigos
  userId    Int?     // Quem fez a ação (pode ser nulo se for ação do sistema)
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@index([userId])
}
// ============================================
// MODELOS PARA INTEGRAÇÃO CEASA
// ============================================

model CeasaPrice {
  id Int @id @default(autoincrement())
  
  // Localização
  ceasa_region String
  ceasa_name String
  
  // Produto
  product_name String
  unit_type String?
  
  // Preços (em Decimal para evitar problemas de ponto flutuante)
  price_min Float
  price_max Float
  price_avg Float
  
  // Data e Timestamps
  price_date DateTime
  sync_timestamp DateTime @default(now())
  
  // Índices para queries rápidas
  @@unique([ceasa_region, product_name, price_date])
  @@index([product_name])
  @@index([ceasa_region])
  @@index([price_date])
}

model CeasaSyncLog {
  id Int @id @default(autoincrement())
  
  source String
  status String
  records_synced Int
  error_message String?
  
  sync_timestamp DateTime @default(now())
  
  @@index([source])
  @@index([sync_timestamp])
}
